<UserControl x:Class="R18MediaLibrary.Views.MediaLibPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:R18MediaLibrary.Controls"
             IsVisibleChanged="Page_IsVisibleChanged">
    <UserControl.Resources>
        <!-- 整页预览左右切换的半透明圆形箭头按钮 -->
        <Style x:Key="PreviewArrowButton" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#66000000" CornerRadius="28">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#AA000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏（对齐 Web header #topbar）：← 返回 · 标题 · 搜索框（撑满）· 显示社团/作品 · 排序；
             详情页（Web .detail-mode）标题与搜索框收起，操作条紧跟返回键、靠左。
             计数行（Web .count）不在顶栏里，而是顶栏下方单独一行，空时整行收起 -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource ToolbarCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Margin="0,0,8,0" Click="BackButton_Click" Content="← 返回"
                            Visibility="Collapsed" />
                    <!-- Web .title：16px 粗体，过长省略 -->
                    <TextBlock x:Name="TitleLabel" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="16" FontWeight="SemiBold" MaxWidth="420"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="SearchBox" Grid.Column="2" MinWidth="140" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" />
                    <!-- 详情操作条顺序对齐 Web：已读 → 收藏 → 移动媒体库 → 删除作品（library.js .topbar-actions .toggle）；
                         打开文件夹为桌面独有，置于其后。原「查看作品」按钮已撤：作品文件直接画在详情页下方 -->
                    <StackPanel x:Name="DetailActions" Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Left" Visibility="Collapsed">
                        <StackPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Padding" Value="12,5" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="FontFamily" Value="Segoe UI Emoji" />
                            </Style>
                        </StackPanel.Resources>
                        <Button x:Name="ReadButton" Visibility="Collapsed" Click="ReadButton_Click" Content="☆ 已读" />
                        <Button x:Name="FavButton" Visibility="Collapsed" Click="FavButton_Click" Content="♡ 收藏" />
                        <Button x:Name="MoveLibButton" Visibility="Collapsed" Click="MoveLibButton_Click" Content="📦 移动媒体库" />
                        <Button x:Name="DeleteWorkButton" Visibility="Collapsed" Click="DeleteWorkButton_Click"
                                Content="🗑 删除作品" Padding="12,5" FontSize="13" Margin="0,0,8,0"
                                FontFamily="Segoe UI Emoji" Style="{StaticResource DangerButton}" />
                        <Button x:Name="OpenFolderButton" Visibility="Collapsed" Click="OpenFolderButton_Click" Content="📂 打开文件夹" />
                    </StackPanel>
                    <Button x:Name="LibToggleButton" Grid.Column="3" Margin="8,0,0,0" Visibility="Collapsed"
                            VerticalAlignment="Center" FontFamily="Segoe UI Emoji"
                            Click="LibToggleButton_Click" Content="🏢 显示社团" />
                    <ComboBox x:Name="SortBox" Grid.Column="4" Margin="8,0,0,0" MinWidth="130" Visibility="Collapsed"
                              VerticalAlignment="Center" SelectionChanged="SortBox_SelectionChanged" />
                    <!-- 媒体库设置已移入「系统设置」页（对齐 Web），此处不再提供入口 -->
                </Grid>
            </Border>
            <!-- Web .count：muted 13px，margin 4px 2px 12px；没有计数的页（详情）整行不占位 -->
            <TextBlock x:Name="CountLabel" Foreground="{StaticResource CaptionBrush}" FontSize="13"
                       Margin="2,4,2,12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- 卡片区 / 详情区 -->
        <Grid Grid.Row="1">
            <!-- 卡片区：虚拟化换行网格（万级作品只渲染视口内的卡片，滚动内存恒定） -->
            <ItemsControl x:Name="CardList" Visibility="Collapsed"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="CardListScroll" CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 列宽/列数随窗口自适应（规则同 Web app.css 的 CSS Grid，见 Controls/CardGrid.cs）：
                             作品卡 min 150 / 最多 8 列 / 高宽比 1.5；分组卡 min 220 / 不限列 / 固定高 -->
                        <ctrl:VirtualizingWrapPanel
                            MinItemWidth="{Binding CardMinWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            MaxColumns="{Binding CardMaxColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ItemAspect="{Binding CardAspect, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ItemHeight="{Binding CardCellHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ItemGap="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding Element}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 详情 / 文件树区（非卡片流，用普通滚动容器承载任意内容） -->
            <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto">
                <ContentPresenter x:Name="ContentHost" />
            </ScrollViewer>
        </Grid>

        <!-- 底部音频播放条由代码动态加入 RootGrid 第 2 行（避免 XAML 引用本程序集类型触发临时程序集编译） -->

        <!-- 整页预览覆盖层（图片/视频），盖住顶栏与详情区 -->
        <Grid x:Name="PreviewOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{StaticResource WindowBrush}" Focusable="True"
              KeyDown="PreviewOverlay_KeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PreviewCloseButton" Click="PreviewClose_Click" Content="← 返回" />
                <TextBlock x:Name="PreviewTitle" Grid.Column="1" VerticalAlignment="Center"
                           Margin="12,0" TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="PreviewNavBar" Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="PreviewPrevButton" Click="PreviewPrev_Click" Content="‹ 上一张" />
                    <Button x:Name="PreviewNextButton" Click="PreviewNext_Click" Content="下一张 ›"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
            <Border x:Name="PreviewContent" Grid.Row="1" Background="#111111" CornerRadius="4" />
            <!-- 图片左右切换箭头：覆盖在预览图两侧、垂直居中 -->
            <Button x:Name="PreviewPrevArrow" Grid.Row="1" Style="{StaticResource PreviewArrowButton}"
                    HorizontalAlignment="Left" Margin="20,0,0,0" Content="‹"
                    Click="PreviewPrev_Click" Visibility="Collapsed" />
            <Button x:Name="PreviewNextArrow" Grid.Row="1" Style="{StaticResource PreviewArrowButton}"
                    HorizontalAlignment="Right" Margin="0,0,20,0" Content="›"
                    Click="PreviewNext_Click" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
