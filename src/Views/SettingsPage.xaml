<UserControl x:Class="R18MediaLibrary.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="Page_IsVisibleChanged">
    <UserControl.Resources>
        <!-- 表单标签（Web .frow > label）：muted 13.5px，定宽 120，与控件间距 10 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource CaptionBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- 页顶标题横条（Web 顶栏 #title =「系统设置」），常驻在滚动区之外 -->
    <Border Style="{StaticResource ToolbarCard}">
        <DockPanel>
            <!-- ? 使用帮助（Web 顶栏 #helpBtn），按钮由代码挂上（HelpPanel.Button） -->
            <ContentControl x:Name="HelpSlot" DockPanel.Dock="Right" Margin="8,0,0,0" />
            <TextBlock x:Name="PageTitle" Text="系统设置" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Stretch" MaxWidth="1100" Margin="0,0,8,0">

            <!-- 下载 -->
            <GroupBox x:Name="DownloadGroup" Header="下载">
                <StackPanel>
                    <DockPanel Margin="0,5">
                        <TextBlock x:Name="PathLabel" Text="缓存路径" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left" />
                        <Button x:Name="PathChooseButton" Content="保存" Margin="8,0,0,0" DockPanel.Dock="Right"
                                Click="PathChooseButton_Click" />
                        <TextBox x:Name="PathBox" LostFocus="PathBox_LostFocus" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock x:Name="AutoDownloadLabel" Text="自动下载" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="AutoDownloadCombo" Width="120"
                                  SelectionChanged="AutoDownloadCombo_SelectionChanged" />
                        <TextBlock x:Name="AutoUnzipLabel" Text="自动解压" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <ComboBox x:Name="AutoUnzipCombo" Width="120"
                                  SelectionChanged="AutoUnzipCombo_SelectionChanged" />
                    </StackPanel>
                    <!-- 线程 / 速度：Web 端 下载 分区内含此三项（settings.js），故并入「下载」而非独立分区 -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock x:Name="DownProcLabel" Text="单文件线程数" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="DownProcBox" Width="80" SelectionChanged="DownProcBox_SelectionChanged">
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="5" />
                            <ComboBoxItem Content="6" />
                        </ComboBox>
                        <TextBlock x:Name="MinSpeedLabel" Text="最低速度 (KB/s)" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <TextBox x:Name="MinSpeedBox" Width="80" LostFocus="MinSpeedBox_LostFocus" />
                        <TextBlock x:Name="SpeedLimitLabel" Text="速度限制 (KB/s)" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <TextBox x:Name="SpeedLimitBox" Width="80" LostFocus="SpeedLimitBox_LostFocus" />
                    </StackPanel>
                    <!-- 解压密码库：一个输入框一个密码，末尾「＋」新增一条（对齐 Web settings.js）。
                         行由代码后台的 RebuildUnzipPwdRows 生成，存库时仍是「一行一个」的老格式 -->
                    <DockPanel Margin="0,5">
                        <TextBlock x:Name="UnzipPwdLabel" Text="解压密码库" Style="{StaticResource FieldLabel}"
                                   DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,9,10,0" />
                        <WrapPanel x:Name="UnzipPwdList" Margin="0,4,0,0" />
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <!-- 代理 -->
            <GroupBox x:Name="ProxyGroup" Header="代理">
                <StackPanel>
                    <DockPanel Margin="0,5">
                        <TextBlock x:Name="ProxyStatusLabel" Text="开启" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left" />
                        <ComboBox x:Name="ProxyStatusCombo" Width="120" DockPanel.Dock="Left"
                                  SelectionChanged="ProxyStatusCombo_SelectionChanged" />
                        <ComboBox x:Name="ProxyTypeCombo" Width="100" Margin="8,0,0,0" DockPanel.Dock="Left"
                                  SelectionChanged="ProxyTypeCombo_SelectionChanged" />
                        <TextBox x:Name="ProxyPortBox" Width="80" Margin="8,0,0,0" DockPanel.Dock="Right"
                                 LostFocus="Proxy_LostFocus" />
                        <TextBox x:Name="ProxyHostBox" Margin="8,0,0,0"
                                 LostFocus="Proxy_LostFocus" />
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <!-- Debrid-Link -->
            <GroupBox x:Name="DebridGroup" Header="Debrid-Link 下载中转站">
                <StackPanel>
                    <DockPanel Margin="0,5">
                        <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left" />
                        <Button x:Name="DebridTestButton" Content="测试" Margin="8,0,0,0" DockPanel.Dock="Right"
                                Click="DebridTestButton_Click" />
                        <TextBox x:Name="DebridKeyBox" LostFocus="DebridKeyBox_LostFocus" />
                    </DockPanel>
                    <!-- debrid-link 不可用（无 Key / Key 失效 / 会员到期）时 rapidgator、katfile 走网盘免费下载（FreeHostDownloader） -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock x:Name="FreeHostLabel" Text="网盘免费下载" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="FreeHostCombo" Width="120"
                                  SelectionChanged="FreeHostCombo_SelectionChanged" />
                        <TextBlock x:Name="FreeHostIntervalLabel" Text="下载间隔 (分钟)" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <TextBox x:Name="FreeHostIntervalBox" Width="80" LostFocus="FreeHostIntervalBox_LostFocus" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 作品类型优先搜索 -->
            <GroupBox x:Name="SearchSourceGroup" Header="作品类型优先搜索">
                <StackPanel>
                    <!-- 每个已知作品类型一行（动态生成）：类型名（代码）+ 来源下拉 -->
                    <WrapPanel x:Name="SearchSourcePanel" />
                </StackPanel>
            </GroupBox>

            <!-- ASMR.ONE -->
            <GroupBox x:Name="AsmrGroup" Header="ASMR.ONE">
                <StackPanel>
                    <!-- 账号 + 密码 同一行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock x:Name="AsmrUserLabel" Text="账号" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="AsmrUserBox" Width="280" VerticalContentAlignment="Center"
                                 LostFocus="AsmrUserBox_LostFocus" />
                        <TextBlock x:Name="AsmrPassLabel" Text="密码" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <TextBox x:Name="AsmrPassBox" Width="280" VerticalContentAlignment="Center"
                                 LostFocus="AsmrPassBox_LostFocus" />
                        <Button x:Name="AsmrTestButton" Content="登录测试" Margin="16,0,0,0"
                                Click="AsmrTestButton_Click" />
                    </StackPanel>
                    <!-- 镜像站 + 下载文件类型（两行）同一行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="AsmrMirrorLabel" Text="镜像站" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Top" />
                        <ComboBox x:Name="AsmrMirrorCombo" Width="160" VerticalAlignment="Top"
                                  SelectionChanged="AsmrMirrorCombo_SelectionChanged" />
                        <TextBlock x:Name="AsmrFileTypeLabel" Text="下载文件类型" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" VerticalAlignment="Top" />
                        <WrapPanel x:Name="FileTypePanel" MaxWidth="400" VerticalAlignment="Top" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- E-Hentai（桌面独有配置，Web 设置页不暴露；排版随 ASMR.ONE 分区）。
                 账号登录与三个 cookie 已挪到一级导航「账号访问」（AccountPage），这里只留站点与画质 -->
            <GroupBox x:Name="EhentaiGroup" Header="E-Hentai">
                <StackPanel>
                    <!-- 站点 + 下载原图 同一行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock x:Name="EhHostLabel" Text="站点" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="EhHostCombo" Width="160" VerticalContentAlignment="Center"
                                  SelectionChanged="EhHostCombo_SelectionChanged" />
                        <TextBlock x:Name="EhOriginalLabel" Text="图片画质" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <ComboBox x:Name="EhOriginalCombo" Width="200" VerticalContentAlignment="Center"
                                  SelectionChanged="EhOriginalCombo_SelectionChanged" />
                        <Button x:Name="EhTestButton" Content="连接测试" Margin="16,0,0,0"
                                Click="EhTestButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="EhHint" TextWrapping="Wrap" Margin="120,6,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="登录（访问里站、下载原图）请到左侧「账号访问」页。" />
                </StackPanel>
            </GroupBox>

            <!-- pixiv（桌面独有配置，Web 设置页不暴露；排版随 E-Hentai 分区）。PHPSESSID 已挪到「账号访问」 -->
            <GroupBox x:Name="PixivGroup" Header="Pixiv">
                <StackPanel>
                    <!-- 画质 + 分级 + 匹配方式 同一行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock x:Name="PxOriginalLabel" Text="图片画质" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="PxOriginalCombo" Width="200" VerticalContentAlignment="Center"
                                  SelectionChanged="PxOriginalCombo_SelectionChanged" />
                        <TextBlock x:Name="PxModeLabel" Text="搜索分级" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <ComboBox x:Name="PxModeCombo" Width="120" VerticalContentAlignment="Center"
                                  SelectionChanged="PxModeCombo_SelectionChanged" />
                        <TextBlock x:Name="PxMatchLabel" Text="匹配方式" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <ComboBox x:Name="PxMatchCombo" Width="160" VerticalContentAlignment="Center"
                                  SelectionChanged="PxMatchCombo_SelectionChanged" />
                        <Button x:Name="PxTestButton" Content="连接测试" Margin="16,0,0,0"
                                Click="PxTestButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PxHint" TextWrapping="Wrap" Margin="120,6,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="未登录也能搜索，但站点会把 R-18 作品从结果里滤掉。要看 R-18，请到左侧「账号访问」页登录 Pixiv。" />
                </StackPanel>
            </GroupBox>

            <!-- 系统（顺序对齐 Web：系统在外部访问之前，settings.js）。关闭按钮为桌面独有项 -->
            <GroupBox x:Name="SystemGroup" Header="系统">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock x:Name="LanguageLabel" Text="语言" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="LanguageCombo" Width="140"
                                  SelectionChanged="LanguageCombo_SelectionChanged" />
                        <TextBlock x:Name="LogLevelLabel" Text="日志级别" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <ComboBox x:Name="LogLevelCombo" Width="120"
                                  SelectionChanged="LogLevelCombo_SelectionChanged" />
                        <TextBlock x:Name="EncodingLabel" Text="解压编码" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <TextBox x:Name="EncodingBox" Width="120" LostFocus="EncodingBox_LostFocus" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <TextBlock x:Name="CloseActionLabel" Text="关闭按钮" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="CloseActionCombo" Width="180"
                                  SelectionChanged="CloseActionCombo_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 媒体库（内联管理，对齐 Web 设置页：位于「系统」与「外部访问」之间）。
                 桌面端以此取代原独立弹窗；区块由 MediaLibSettingDialog.BuildSection 在代码后台注入 -->
            <GroupBox x:Name="MediaLibGroup" Header="媒体库">
                <ContentControl x:Name="MediaLibHost" />
            </GroupBox>

            <!-- 图床存储（对齐 Web 设置页：位于「媒体库」与「外部访问」之间，settings.js） -->
            <GroupBox x:Name="ImageHostGroup" Header="图床存储">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock x:Name="ImageHostEnableLabel" Text="启用" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ImageHostEnableCombo" Width="120"
                                  SelectionChanged="ImageHostEnableCombo_SelectionChanged" />
                        <TextBlock x:Name="ImageHostProjectLabel" Text="项目" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <TextBox x:Name="ImageHostProjectBox" Width="180" LostFocus="ImageHostProjectBox_LostFocus" />
                    </StackPanel>
                    <DockPanel Margin="0,8,0,4">
                        <TextBlock x:Name="ImageHostUrlLabel" Text="服务地址" Style="{StaticResource FieldLabel}"
                                   DockPanel.Dock="Left" />
                        <TextBox x:Name="ImageHostUrlBox" LostFocus="ImageHostUrlBox_LostFocus" />
                    </DockPanel>
                    <DockPanel Margin="0,5">
                        <TextBlock x:Name="ImageHostTokenLabel" Text="API Token" Style="{StaticResource FieldLabel}"
                                   DockPanel.Dock="Left" />
                        <Button x:Name="ImageHostMigrateButton" Content="迁移封面" Margin="8,0,0,0"
                                DockPanel.Dock="Right" Click="ImageHostMigrateButton_Click" />
                        <Button x:Name="ImageHostTestButton" Content="测试连接" Margin="8,0,0,0"
                                DockPanel.Dock="Right" Click="ImageHostTestButton_Click" />
                        <TextBox x:Name="ImageHostTokenBox" LostFocus="ImageHostTokenBox_LostFocus" />
                    </DockPanel>
                    <TextBlock x:Name="ImageHostStatusLabel" Margin="0,6,0,0"
                               Foreground="{StaticResource CaptionBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <!-- 图片翻译（按需功能：模型依赖没下齐之前「启用」不可选） -->
            <GroupBox x:Name="TranslateGroup" Header="图片翻译">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock x:Name="TransEnableLabel" Text="启用" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="TransEnableCombo" Width="120"
                                  SelectionChanged="TransEnableCombo_SelectionChanged" />
                        <TextBlock x:Name="TransTierLabel" Text="模型档位" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <ComboBox x:Name="TransTierCombo" Width="140"
                                  SelectionChanged="TransTierCombo_SelectionChanged" />
                        <TextBlock x:Name="TransDeviceLabel" Text="推理设备" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <ComboBox x:Name="TransDeviceCombo" Width="100"
                                  SelectionChanged="TransDeviceCombo_SelectionChanged" />
                    </StackPanel>
                    <DockPanel Margin="0,8,0,4">
                        <TextBlock x:Name="TransPathLabel" Text="模型目录" Style="{StaticResource FieldLabel}"
                                   DockPanel.Dock="Left" />
                        <Button x:Name="TransPathChooseButton" Content="浏览" Margin="8,0,0,0"
                                DockPanel.Dock="Right" Click="TransPathChooseButton_Click" />
                        <TextBox x:Name="TransPathBox" LostFocus="TransPathBox_LostFocus" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <TextBlock x:Name="TransFontLabel" Text="嵌字字体" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TransFontBox" Width="180" LostFocus="TransFontBox_LostFocus" />
                        <Button x:Name="TransDownloadButton" Content="下载依赖" Margin="24,0,0,0"
                                Click="TransDownloadButton_Click" />
                        <Button x:Name="TransCancelButton" Content="取消下载" Margin="8,0,0,0"
                                Click="TransCancelButton_Click" />
                        <Button x:Name="TransRemoveButton" Content="删除依赖" Margin="8,0,0,0"
                                Click="TransRemoveButton_Click" />
                    </StackPanel>
                    <ProgressBar x:Name="TransProgressBar" Height="6" Margin="0,8,0,0"
                                 Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <TextBlock x:Name="TransStatusLabel" Margin="0,6,0,0"
                               Foreground="{StaticResource CaptionBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <!-- 外部访问 -->
            <GroupBox x:Name="WebGroup" Header="外部访问">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock x:Name="WebEnableLabel" Text="外部访问" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="WebEnableCombo" Width="120"
                                  SelectionChanged="WebEnableCombo_SelectionChanged" />
                        <TextBlock x:Name="WebPortLabel" Text="端口" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <TextBox x:Name="WebPortBox" Width="90" LostFocus="WebPortBox_LostFocus" />
                        <TextBlock x:Name="WebPasswordLabel" Text="访问密码" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <TextBox x:Name="WebPasswordBox" Width="160" LostFocus="WebPasswordBox_LostFocus" />
                    </StackPanel>
                    <TextBlock x:Name="WebStatusLabel" Margin="0,6,0,0"
                               Foreground="{StaticResource CaptionBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <!-- 门户单点登录（桌面独有配置，Web 设置页不暴露；排版随图床存储分区）。
                 本程序这边开了才生效：关着时 /api/sso/* 一律 404，Web 登录页也不画「门户登录」 -->
            <GroupBox x:Name="SsoGroup" Header="门户单点登录">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock x:Name="SsoEnableLabel" Text="启用" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="SsoEnableCombo" Width="120"
                                  SelectionChanged="SsoEnableCombo_SelectionChanged" />
                        <TextBlock x:Name="SsoClientIdLabel" Text="Client ID" Style="{StaticResource FieldLabel}"
                                   MinWidth="0" Margin="24,0,10,0" />
                        <TextBox x:Name="SsoClientIdBox" Width="180" LostFocus="SsoBox_LostFocus" Tag="client_id" />
                    </StackPanel>
                    <DockPanel Margin="0,8,0,4">
                        <TextBlock x:Name="SsoPortalUrlLabel" Text="门户地址" Style="{StaticResource FieldLabel}"
                                   DockPanel.Dock="Left" />
                        <TextBox x:Name="SsoPortalUrlBox" LostFocus="SsoBox_LostFocus" Tag="portal_url" />
                    </DockPanel>
                    <DockPanel Margin="0,5">
                        <TextBlock x:Name="SsoInternalUrlLabel" Text="内网地址" Style="{StaticResource FieldLabel}"
                                   DockPanel.Dock="Left" />
                        <TextBox x:Name="SsoInternalUrlBox" LostFocus="SsoBox_LostFocus" Tag="internal_url" />
                    </DockPanel>
                    <DockPanel Margin="0,5">
                        <TextBlock x:Name="SsoSecretLabel" Text="Client Secret" Style="{StaticResource FieldLabel}"
                                   DockPanel.Dock="Left" />
                        <TextBox x:Name="SsoSecretBox" LostFocus="SsoBox_LostFocus" Tag="client_secret" />
                    </DockPanel>
                    <TextBlock x:Name="SsoStatusLabel" Margin="0,6,0,0"
                               Foreground="{StaticResource CaptionBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SsoUsersLabel" Text="用户" Margin="0,12,0,4" />
                    <StackPanel x:Name="SsoUsersPanel" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
