<UserControl x:Class="R18MediaLibrary.Views.DownloadedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="Page_IsVisibleChanged">
    <UserControl.Resources>
        <!-- 过长文本显示省略号，悬停时用气泡展示全文 -->
        <Style x:Key="EllipsisCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 可点击排序的表头（Web .dt th：muted、500 字重） -->
        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CaptionBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 表格行（Web .dt td）：无卡片，单元格内距 8/10、行底一道 line 分隔，悬停整行 surface 底 -->
        <Style x:Key="RowCard" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CardBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CardBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid TextElement.FontSize="13.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏（对齐 Web renderDownloaded 的 .toolbar）：← 下载 · 刷新 · 搜索框（撑满）· 状态筛选 -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <Grid TextElement.FontSize="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Click="BackButton_Click" Content="← 下载" />
                <Button x:Name="RefreshButton" Grid.Column="1" Margin="8,0,0,0" Click="RefreshButton_Click" Content="刷新" />
                <TextBox x:Name="SearchBox" Grid.Column="2" Margin="8,0,0,0" MinWidth="140"
                         VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                <ComboBox x:Name="StateFilter" Grid.Column="3" Margin="8,0,0,0" MinWidth="110"
                          SelectionChanged="StateFilter_SelectionChanged" />
            </Grid>
        </Border>

        <!-- 计数行（Web .count：muted 13px，margin 4 2 12） -->
        <TextBlock x:Name="CountLabel" Grid.Row="1" Margin="2,4,2,12" FontSize="13"
                   Foreground="{StaticResource CaptionBrush}" />

        <!-- 表头：点击切换排序（列宽与行一致；左右各留单元格内距 10，右侧再让出滚动条宽） -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,8,18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" MinWidth="190" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HdrId" Style="{StaticResource HeaderCell}"
                           Tag="WorkId" MouseLeftButtonUp="Header_Click" />
                <TextBlock x:Name="HdrName" Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource HeaderCell}"
                           Tag="WorkName" MouseLeftButtonUp="Header_Click" />
                <TextBlock x:Name="HdrMaker" Grid.Column="2" Margin="0,0,12,0" Style="{StaticResource HeaderCell}"
                           Tag="MakerName" MouseLeftButtonUp="Header_Click" />
                <TextBlock x:Name="HdrType" Grid.Column="3" Margin="0,0,12,0" Style="{StaticResource HeaderCell}"
                           Tag="WorkType" MouseLeftButtonUp="Header_Click" />
                <TextBlock x:Name="HdrState" Grid.Column="4" Style="{StaticResource HeaderCell}"
                           Tag="StateText" MouseLeftButtonUp="Header_Click" />
                <TextBlock x:Name="HdrTime" Grid.Column="5" Style="{StaticResource HeaderCell}"
                           Tag="DownTime" MouseLeftButtonUp="Header_Click" />
            </Grid>
        </Border>

        <!-- 空态（Web .empty「没有内容」） -->
        <TextBlock x:Name="EmptyLabel" Grid.Row="3" Text="没有内容" Foreground="{StaticResource CaptionBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0" FontSize="15">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=WorksList}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 列表：表格行（Web .dt） -->
        <ListBox x:Name="WorksList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource RowCard}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.ScrollChanged="WorksList_ScrollChanged"
                 PreviewMouseRightButtonDown="WorksList_PreviewMouseRightButtonDown"
                 ContextMenuOpening="WorksList_ContextMenuOpening">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" MinWidth="190" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding WorkId}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding WorkName}" Margin="0,0,12,0"
                                   Style="{StaticResource EllipsisCell}" />
                        <TextBlock Grid.Column="2" Text="{Binding MakerName}" Margin="0,0,12,0"
                                   Style="{StaticResource EllipsisCell}" />
                        <TextBlock Grid.Column="3" Text="{Binding WorkType}" Margin="0,0,12,0"
                                   Style="{StaticResource EllipsisCell}" />
                        <!-- 状态（Web .pill）：按状态着色的文字，12px，左右内距 8 -->
                        <TextBlock Grid.Column="4" Text="{Binding StateText}" Foreground="{Binding StateBrush}"
                                   FontSize="12" Padding="8,1" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{Binding DownTime}" VerticalAlignment="Center" />
                        <!-- 行操作（Web .mini）：跳转作品；「已下载」状态再给一个标记为已品悦 -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding OpenText}" Style="{StaticResource MiniButton}"
                                    Click="OpenWork_Click" />
                            <Button Content="{Binding MarkText}" Style="{StaticResource MiniButton}"
                                    Margin="6,0,0,0" Visibility="{Binding MarkVisibility}"
                                    Click="MarkRow_Click" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MarkMenuItem" Header="标记为已品悦" Click="MarkEnjoyed_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </Grid>
</UserControl>
