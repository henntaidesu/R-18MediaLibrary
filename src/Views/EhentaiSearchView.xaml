<UserControl x:Class="R18MediaLibrary.Views.EhentaiSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:R18MediaLibrary.Controls">
    <!-- 「作品搜索」分区里 E-Hentai 来源的结果区（对齐 Web 端 src/Web/js/ehentai.js 的两个面板）。
         工具栏（来源下拉 + 输入框 + 查询 + 返回搜索结果）由宿主 SearchPage 统一提供，本控件只管结果。
         层级只有两级：results（画廊网格）/ detail（单本画廊内容），没有 FANBOX 那种「作家」中间层。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 选择操作条（Web .toolbar.fb-selbar）：仅画廊网格显示。已选计数撑开，右侧 全选 / 清空 / 下载选中 -->
        <Border x:Name="SelectBar" Grid.Row="0" Style="{StaticResource ToolbarCard}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectInfo" VerticalAlignment="Center"
                           Foreground="{StaticResource CaptionBrush}" FontSize="13" Text="已选 0 本" />
                <Button x:Name="SelectAllButton" Grid.Column="1" Margin="8,0,0,0"
                        Click="SelectAll_Click" Content="全选" />
                <Button x:Name="SelectNoneButton" Grid.Column="2" Margin="8,0,0,0"
                        Click="SelectNone_Click" Content="清空" />
                <Button x:Name="DownloadSelectedButton" Grid.Column="3" Margin="8,0,0,0"
                        IsEnabled="False" Style="{StaticResource AccentButton}"
                        Click="DownloadSelected_Click" Content="下载选中" />
            </Grid>
        </Border>

        <!-- 详情操作条（Web ehRenderGallery 的 .toolbar）：左「下载本篇」，右「在站点打开」。
             与 SelectBar 同占第 0 行（按层级互斥显示），放在滚动区之外，常驻页顶 -->
        <Border x:Name="DetailBar" Grid.Row="0" Style="{StaticResource ToolbarCard}" Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <Button x:Name="DetailDownloadButton" DockPanel.Dock="Left"
                        Style="{StaticResource AccentButton}"
                        Click="DetailDownload_Click" Content="下载本篇" />
                <Button x:Name="DetailOpenSiteButton" DockPanel.Dock="Right"
                        Click="DetailOpenSite_Click" Content="在站点打开" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- 画廊卡网格：排布与媒体库作品卡一致（同 Web .grid.cards） -->
            <ListBox x:Name="CardList" Background="Transparent"
                     ItemContainerStyle="{StaticResource CardGridItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Standard"
                     ScrollViewer.ScrollChanged="CardList_ScrollChanged"
                     SelectionChanged="CardList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctrl:VirtualizingWrapPanel MinItemWidth="150" MaxColumns="8"
                                                    ItemGap="12" ItemAspect="1.5" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 结构对齐 Web 的 .card.mk：封面占卡片高度 2/3，底部 1/3 放标题 + 常驻操作按钮行；
                             PickCard = 悬停描边 + 已选 2px 强调描边（.card.picked） -->
                        <Border Style="{StaticResource PickCard}" Padding="0" ClipToBounds="True"
                                Opacity="{Binding CardOpacity}" ToolTip="{Binding Title}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 封面（Web .cover 底色 #15151a）：满幅按比例铺满裁切。
                                     图用 ImageBrush 画在带圆角的 Border 上——塞 Image 进去顶角会戳出卡片圆角 -->
                                <Grid ClipToBounds="True">
                                    <Border Background="#15151A" CornerRadius="9,9,0,0" />
                                    <Border CornerRadius="9,9,0,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <!-- 角标（.badge：rgba(0,0,0,.62)、圆角 6）：左上页数（.badge.rj）/ 右上分类（.badge.type） -->
                                    <Grid VerticalAlignment="Top" Margin="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border HorizontalAlignment="Left"
                                                Background="#9E000000" CornerRadius="6" Padding="7,1"
                                                Visibility="{Binding MetaVisibility}">
                                            <TextBlock Text="{Binding MetaText}" Foreground="#F3F3F3" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Border Grid.Column="1" HorizontalAlignment="Right" Margin="6,0,0,0"
                                                Background="#9E000000" CornerRadius="6" Padding="7,1"
                                                Visibility="{Binding TagVisibility}">
                                            <TextBlock Text="{Binding TagText}" Foreground="#F3F3F3" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                    <!-- 底部（.badge.lib）：已下载 / 下载中 -->
                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="6"
                                            Background="#E66E6E7A" CornerRadius="6" Padding="7,1"
                                            Visibility="{Binding StateVisibility}">
                                        <TextBlock Text="{Binding StateText}" Foreground="#F3F3F3"
                                                   FontSize="11" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- 底部 1/3（Web .mk-foot）：标题占满剩余高度、超出省略；按钮行常驻在底 -->
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- 最多两行、超出省略（Web .card.mk .wt 的 line-clamp: 2） -->
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Medium"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="36"
                                               VerticalAlignment="Top" Margin="10,8,10,4" />

                                    <!-- 卡内常驻操作按钮行：对齐 Web 的 .mcard-actions。
                                         未下载 [选择/已选][下载]，已下载/下载中为禁用的状态按钮。 -->
                                    <Grid Grid.Row="1" Height="26" Margin="8,4,8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource CardActionButton}"
                                                Visibility="{Binding SelectVisibility}"
                                                Background="{Binding PickBackground}"
                                                Foreground="{Binding PickForeground}"
                                                Content="{Binding PickText}"
                                                Click="PickButton_Click" />
                                        <Button Grid.Column="1" Margin="6,0,0,0"
                                                Style="{StaticResource CardActionButton}"
                                                Visibility="{Binding SelectVisibility}"
                                                Background="{StaticResource AccentBrush}"
                                                BorderBrush="{StaticResource AccentBrush}"
                                                Foreground="White"
                                                ToolTip="只下载这一本" Content="下载"
                                                Click="DownloadOne_Click" />
                                        <Button Grid.ColumnSpan="2" Style="{StaticResource CardActionButton}"
                                                Visibility="{Binding BusyVisibility}" IsEnabled="False"
                                                Content="{Binding StateText}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 画廊详情（对齐 Web 的 ehRenderGallery）：上半封面 + 字段（Web .detail > .dtop > .gallery + .fields），
                 下半「全部图片（N 页）」整本缩略图网格（.ehgrid），下拉到底再翻下一列表页。
                 顶部「下载本篇 / 在站点打开」操作条见上面的 DetailBar（在滚动区之外，常驻页顶）。 -->
            <ScrollViewer x:Name="DetailPane" Visibility="Collapsed" ScrollChanged="DetailPane_ScrollChanged"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.6*" />
                                </Grid.ColumnDefinitions>

                                <!-- 封面：只是张封面，点不开东西（Web .gallery img.main） -->
                                <StackPanel>
                                    <Border Background="#15151A" CornerRadius="8" MinHeight="140">
                                        <Image x:Name="DetailMainImage" Stretch="Uniform" MaxHeight="460" />
                                    </Border>
                                    <TextBlock x:Name="DetailNoImage" Text="取不到封面" Visibility="Collapsed"
                                               Foreground="{StaticResource CaptionBrush}" Margin="0,10,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- 字段（原名 / 社团 / 分类 / 投稿者 / 投稿 / 评分 / 页数 / 标签 / 状态）：两列「键 | 值」 -->
                                <StackPanel x:Name="DetailFields" Grid.Column="1" Margin="18,0,0,0"
                                            Grid.IsSharedSizeScope="True" />
                            </Grid>

                            <!-- 全部图片（Web h1.fb-subtitle + .ehgrid）：每格按站点给的单格尺寸，左下角页码 -->
                            <TextBlock x:Name="DetailPagesHeader" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,22,0,0" Visibility="Collapsed" />
                            <ItemsControl x:Name="DetailPages" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- .ehcell：间距 8；悬停描边强调（.ehthumb:hover outline） -->
                                        <Border Margin="0,0,8,8" CornerRadius="5" BorderThickness="2" Cursor="Hand"
                                                ToolTip="{Binding Name}" MouseLeftButtonUp="DetailPage_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentLightBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Width="{Binding W}" Height="{Binding H}">
                                                <Border CornerRadius="4" Background="{StaticResource ButtonBrush}" />
                                                <Border CornerRadius="4">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                                <!-- .ehnum：左下页码，rgba(0,0,0,.66) 底、白字 11px -->
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3"
                                                        Background="#A8000000" CornerRadius="3" Padding="5,0">
                                                    <TextBlock Text="{Binding IndexText}" Foreground="White" FontSize="11"
                                                               LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- .ehmore：加载更多 / 出错提示，灰字居中 -->
                            <TextBlock x:Name="DetailMore" HorizontalAlignment="Center" Margin="0,4,0,8"
                                       Foreground="{StaticResource CaptionBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 加载遮罩 -->
            <Border x:Name="LoadingOverlay" Background="#96000000" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="6"
                                 Foreground="{StaticResource AccentLightBrush}" />
                    <TextBlock x:Name="LoadingText" Text="正在查询…" Margin="0,12,0,0"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
