<UserControl x:Class="R18MediaLibrary.Views.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:R18MediaLibrary.Views"
             IsVisibleChanged="Page_IsVisibleChanged">
    <UserControl.Resources>
        <!-- 目录树展开/收起小三角（文件夹节点用） -->
        <Style x:Key="ExpandToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource CaptionBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Content" Value="▸" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="▾" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 文件叶子节点（按类型隐式套用：目录树里出现 DownloadFileItem 即用此模板） -->
        <!-- 对齐 Web .dfile：文件名（灰、撑满）· 120×8 细进度条 · 速度（右对齐 11.5px）· 状态 · 复制链接（.mini），间距 8；
             失败原因（.ferr）另起一行 12px 红字 -->
        <DataTemplate DataType="{x:Type v:DownloadFileItem}">
            <StackPanel Margin="0,3">
                <Grid TextElement.FontSize="12.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="Auto" MinWidth="62" />
                        <ColumnDefinition Width="Auto" MinWidth="60" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FileName}"
                               Foreground="{StaticResource CaptionBrush}"
                               ToolTip="{Binding Url}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Grid.Column="1" Value="{Binding Pct}" Maximum="100"
                                 Height="8" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding SpeedText}"
                               Foreground="{StaticResource CaptionBrush}" FontSize="11.5"
                               TextAlignment="Right" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                               Foreground="{Binding StatusBrush}" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="4" Content="{Binding CopyUrlText}"
                            Style="{StaticResource MiniButton}" Margin="8,0,0,0"
                            Click="CopyUrl_Click" />
                </Grid>
                <TextBlock Text="{Binding ErrorReason}"
                           Visibility="{Binding ErrorVisibility}"
                           Foreground="{StaticResource RedBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="4,0,0,3" />
            </StackPanel>
        </DataTemplate>

        <!-- 文件夹节点：标题行 + 递归子节点（子节点按类型隐式套用上面的文件/文件夹模板） -->
        <DataTemplate DataType="{x:Type v:DownloadFolderItem}">
            <!-- 对齐 Web .dfhead：▾ + 文件夹名（粗体）+「N 项」（灰），12.5px -->
            <StackPanel Margin="0,3,0,0" TextElement.FontSize="12.5">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton IsChecked="{Binding IsExpanded}" Style="{StaticResource ExpandToggle}" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="2,0,0,0" />
                    <TextBlock Text="{Binding Children.Count, StringFormat={}{0} 项}"
                               Foreground="{StaticResource CaptionBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Children}" Visibility="{Binding ChildrenVisibility}"
                              Margin="16,0,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏：按钮集合与顺序对齐 Web 下载管理（js/download.js renderDownloadSection）：
             已下载 · 清除已完成 · 清除无可用连接 · 清空列表 · 开始下载 · 全部重新解析 · 用量。
             没有「刷新」：列表本就每秒自动刷新（_refreshTimer），同 Web 的每秒轮询。
             整条包进 ToolbarCard：与 Web 的 .toolbar 一样是一张常驻页顶的悬浮卡片 -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- "已下载"为本分区第二视图入口（对齐 Web 下载管理工具栏首位）；搜索已移到独立的"DLsite 搜索"导航 -->
                <Button x:Name="ShowDownloadedButton"
                        Click="ShowDownloadedButton_Click" Content="已下载" />
                <Button x:Name="ClearDoneButton" Grid.Column="1" Margin="8,0,0,0"
                        Click="ClearDoneButton_Click" Content="清除已完成" />
                <Button x:Name="ClearNoLinkButton" Grid.Column="2" Margin="8,0,0,0"
                        Click="ClearNoLinkButton_Click" Content="清除无可用连接" />
                <Button x:Name="ClearAllButton" Grid.Column="3" Margin="8,0,0,0"
                        Click="ClearAllButton_Click" Content="清空列表" />
                <!-- 开始/暂停：始终为蓝色主按钮，只切文案（对齐 Web 的 .icon-btn.primary） -->
                <Button x:Name="StartButton" Grid.Column="4" Margin="8,0,0,0" MinWidth="100"
                        Style="{StaticResource AccentButton}"
                        Click="StartButton_Click" Content="开始下载" />
                <Button x:Name="ReparseAllButton" Grid.Column="5" Margin="8,0,0,0"
                        Click="ReparseAllButton_Click" Content="全部重新解析" />
                <!-- debrid-link 使用量卡片（Web .usage-card）：靠右，surface2 底 + 描边 + 圆角 10，
                     上一行灰字说明、下一条 6px 紫色细条（.bar > i 的 #a78bfa）；点击看各网盘详情 -->
                <Border Grid.Column="7" MinWidth="220" Background="{StaticResource ButtonBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="12,7" Cursor="Hand" MouseLeftButtonUp="Usage_Click"
                        ToolTip="点击查看各网盘流量详情">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UsageLabel" Foreground="{StaticResource CaptionBrush}" FontSize="12.5"
                                   Text="debrid-link 使用量 --" />
                        <ProgressBar x:Name="UsageBar" Height="6" Margin="0,6,0,0" Foreground="#a78bfa" />
                    </StackPanel>
                </Border>
                <!-- ? 使用帮助（Web 工具栏末尾的 helpButton），按钮由代码挂上 -->
                <ContentControl x:Name="HelpSlot" Grid.Column="8" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 空态（Web .empty「下载列表为空」：灰字居中、上下留白 50） -->
        <TextBlock Grid.Row="1" Text="下载列表为空" x:Name="EmptyLabel"
                   Foreground="{StaticResource CaptionBrush}" HorizontalAlignment="Center"
                   VerticalAlignment="Top" Margin="0,50,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=GroupList}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 下载列表（两级树：番号 -> 分卷文件）；虚拟化：仅渲染视口内的番号卡，元素数量恒定 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
            <ItemsControl x:Name="GroupList"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Web .dl：padding 10/14、行间距 8 -->
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- 父行：列序对齐 Web .drow——▸ · 作品名（撑满）· 进度条 · 状态 · 速度 · 操作，间距 10 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton IsChecked="{Binding IsExpanded}" Width="16" Height="20"
                                                  HorizontalAlignment="Left"
                                                  Background="Transparent" BorderThickness="0"
                                                  Foreground="{StaticResource CaptionBrush}"
                                                  Cursor="Hand">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Content" Value="▸" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Content" Value="▾" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkId}"
                                               VerticalAlignment="Center" />
                                    <!-- Web .dprog：18px 高、圆角 5，百分比居中叠在上面（11px） -->
                                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <ProgressBar Value="{Binding Pct}" Maximum="100" Height="18" />
                                        <TextBlock Text="{Binding PctText}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <!-- Web .dst：13px 粗体，按状态着色，过长省略 -->
                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                                               Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <!-- Web .dsp：灰 12.5px，右对齐 -->
                                    <TextBlock Grid.Column="4" Text="{Binding SpeedText}"
                                               Foreground="{StaticResource CaptionBrush}" FontSize="12.5"
                                               TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <!-- 行操作（Web .dacts 的 .mini，间距 6）：跳转作品排第一；只有「删除」是红色 -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0">
                                        <StackPanel.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource MiniButton}">
                                                <Setter Property="Margin" Value="0,0,6,0" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <Button Content="{Binding OpenText}" Visibility="{Binding OpenVisibility}"
                                                Click="OpenWork_Click" />
                                        <Button Content="{Binding DownloadText}"
                                                Visibility="{Binding ResumeVisibility}" Click="DownloadOne_Click" />
                                        <Button Content="{Binding StopText}" Visibility="{Binding PauseVisibility}"
                                                Click="StopOne_Click" />
                                        <Button Content="{Binding ReparseText}" Visibility="{Binding ActionsVisibility}"
                                                Click="Reparse_Click" />
                                        <Button Content="{Binding ResearchText}" Visibility="{Binding ActionsVisibility}"
                                                Click="Research_Click" />
                                        <Button Content="{Binding DeleteText}" Style="{StaticResource MiniDangerButton}"
                                                Click="DeleteOne_Click" />
                                    </StackPanel>
                                </Grid>
                                <!-- 子树：作品内目录层级（文件夹/文件递归），最多约 10 行高，超出滚动 -->
                                <!-- 顶层节点虚拟化：CanContentScroll + VirtualizingStackPanel 只渲染视口内的行 -->
                                <ScrollViewer Visibility="{Binding ChildrenVisibility}" Margin="22,8,0,0"
                                              MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="True">
                                    <!-- 文件/文件夹为异构模板，用 Standard 模式避免回收复用错模板 -->
                                    <ItemsControl ItemsSource="{Binding Nodes}"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Standard"
                                                  VirtualizingPanel.ScrollUnit="Pixel">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
