<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 产品名 R-18MediaLibrary 带连字符，而 C# 命名空间不允许连字符，故两者分开：
         程序集/exe 叫 R-18MediaLibrary，代码里的 namespace 与 RootNamespace 用 R18MediaLibrary。 -->
    <AssemblyName>R-18MediaLibrary</AssemblyName>
    <RootNamespace>R18MediaLibrary</RootNamespace>
    <!-- LibVLCSharp.WPF 的 VideoView 基于 WindowsFormsHost，需要启用 WinForms -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 程序图标（exe / 任务栏 / 窗口标题栏）：Window.Icon 未显式设置时 WPF 回退到本 exe 图标 -->
    <ApplicationIcon>Web\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 外部访问网页：外壳 + 拆分后的静态资源（CSS / 各页面 JS 模块），均作为嵌入资源打包，由 WebAssets 读取 -->
    <EmbeddedResource Include="Web\index.html" />
    <EmbeddedResource Include="Web\app.css" />
    <EmbeddedResource Include="Web\js\*.js" />
    <!-- 浏览器标签页图标（favicon），由 WebAssets 作为静态资源在鉴权前放行 -->
    <EmbeddedResource Include="Web\favicon.ico" />
    <!-- 图片翻译的依赖清单（内置默认值；模型目录下放同名文件即可覆盖，便于换镜像源） -->
    <EmbeddedResource Include="Services\Translate\translate-models.json" />
    <!-- 程序内「使用帮助」（? 按钮）：直接打包 docs/ 下的使用手册与截图，由 HelpManual 按章节拆分，
         .ja.md / .en.md 要标 WithCulture="false"，否则 MSBuild 把后缀当成区域性、编进卫星程序集，主程序集里就没有了；
         程序里不另存副本——改手册即改帮助 -->
    <EmbeddedResource Include="..\docs\使用手册.md" LogicalName="R18MediaLibrary.Help.manual.zh.md" />
    <EmbeddedResource Include="..\docs\使用手册.ja.md" LogicalName="R18MediaLibrary.Help.manual.ja.md" WithCulture="false" />
    <EmbeddedResource Include="..\docs\使用手册.en.md" LogicalName="R18MediaLibrary.Help.manual.en.md" WithCulture="false" />
    <EmbeddedResource Include="..\docs\assets\manual\*.png" LogicalName="R18MediaLibrary.Help.img.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms 会隐式 using WinForms/Drawing，与 WPF 的 Brush/KeyEventArgs 等冲突，移除之 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="LibVLCSharp" Version="3.8.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Microsoft.Data.Sqlite 10.0.9 传递引入的 SQLitePCLRaw 2.1.11 存在高危漏洞 GHSA-2m69-gcr7-jv3q（捆绑的 SQLite < 3.50.2），显式升级覆盖 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
  </ItemGroup>

</Project>
