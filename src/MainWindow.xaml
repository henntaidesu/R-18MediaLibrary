<Window x:Class="R18MediaLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="R18媒体库" Height="760" Width="1280"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="{StaticResource BaseBrush}">
            <StackPanel>
                <TextBlock x:Name="LogoLabel" Text="R18媒体库" FontSize="17" FontWeight="Bold"
                           Margin="20,22,12,18" />
                <!-- 顺序 / 文案 / 图标对齐 Web 端 SECTIONS (src/Web/js/core.js) -->
                <RadioButton x:Name="NavMediaLib" Style="{StaticResource NavButton}" GroupName="nav"
                             IsChecked="True" Checked="Nav_Checked" Tag="medialib">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📚" FontFamily="Segoe UI Emoji" FontSize="15" Width="26"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavMediaLibLabel" Text="媒体库" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavDownload" Style="{StaticResource NavButton}" GroupName="nav"
                             Checked="Nav_Checked" Tag="download">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬇" FontFamily="Segoe UI Emoji" FontSize="15" Width="26"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavDownloadLabel" Text="下载管理" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSearch" Style="{StaticResource NavButton}" GroupName="nav"
                             Checked="Nav_Checked" Tag="search">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontFamily="Segoe UI Emoji" FontSize="15" Width="26"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavSearchLabel" Text="作品搜索" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavWatch" Style="{StaticResource NavButton}" GroupName="nav"
                             Checked="Nav_Checked" Tag="watch">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏱" FontFamily="Segoe UI Emoji" FontSize="15" Width="26"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavWatchLabel" Text="作家监控" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavTag" Style="{StaticResource NavButton}" GroupName="nav"
                             Checked="Nav_Checked" Tag="tag">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏷" FontFamily="Segoe UI Emoji" FontSize="15" Width="26"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavTagLabel" Text="作品标签" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavMaker" Style="{StaticResource NavButton}" GroupName="nav"
                             Checked="Nav_Checked" Tag="maker">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏢" FontFamily="Segoe UI Emoji" FontSize="15" Width="26"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavMakerLabel" Text="作品社团" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavType" Style="{StaticResource NavButton}" GroupName="nav"
                             Checked="Nav_Checked" Tag="type">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎬" FontFamily="Segoe UI Emoji" FontSize="15" Width="26"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavTypeLabel" Text="作品形式" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavFavorite" Style="{StaticResource NavButton}" GroupName="nav"
                             Checked="Nav_Checked" Tag="favorite">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="♥" FontFamily="Segoe UI Emoji" FontSize="15" Width="26"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavFavoriteLabel" Text="我的收藏" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSetting" Style="{StaticResource NavButton}" GroupName="nav"
                             Checked="Nav_Checked" Tag="setting">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontFamily="Segoe UI Emoji" FontSize="15" Width="26"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavSettingLabel" Text="系统设置" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 右侧页面容器 -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="14" />
    </Grid>
</Window>
